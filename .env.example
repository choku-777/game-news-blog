# WordPress 投稿用の認証情報（コピーして .env を作成し、実値を入れてください）
# .env は .gitignore 済みでコミットされません。

# WordPress サイトの URL（末尾スラッシュなし、https 必須）
# 例: https://example.sakura.ne.jp
WP_URL=

# WordPress のユーザー名（ログインID）
WP_USER=

# WordPress 管理画面 → ユーザー → プロフィール → アプリケーションパスワード で発行した値
# 例: "xxxx xxxx xxxx xxxx xxxx xxxx"（スペース込みのまま貼り付けてOK）
WP_APP_PASSWORD=
